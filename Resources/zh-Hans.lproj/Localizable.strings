"Reset to Defaults" = "恢复默认值";

/* Sleep */
"Keep the Mac Awake" = "保持 Mac 不睡眠";
"By default the Mac is free to go to sleep while Sound Keeper is playing. Turn it on to keep the Mac awake, like a usual audio player does." = "默认情况下，Sound Keeper 播放时 Mac 仍可正常进入睡眠。开启后会像普通播放器一样阻止 Mac 睡眠。";
"Pause While Displays Are Off" = "显示器关闭时暂停";
"Pause While the Screen Is Locked" = "屏幕锁定时暂停";
"Lets your speakers fall asleep when you are away." = "你离开时，让音箱自然进入休眠。";

/* Parameters panel */
"Signal Parameters" = "信号参数";
"Parameters of the signal that keeps your outputs awake. Fields that don't apply to the current signal type are disabled." = "用于保活输出设备的信号参数。不适用于当前信号类型的字段已停用。";
"Frequency:" = "频率：";
"Amplitude:" = "幅度：";
"Length:" = "时长：";
"Waiting:" = "间隔：";
"Fading:" = "淡入淡出：";
"Hz" = "Hz";
"Hz — fluctuations per second" = "Hz — 每秒微扰次数";
"% — 0.1 is inaudible for a noise" = "% — 噪声设为 0.1 即听不见";
"seconds — 0 is infinite" = "秒 — 0 表示一直播放";
"seconds between sounds, if the length is set" = "秒 — 两段声音的间隔（需先设置时长）";
"seconds" = "秒";
"OK" = "好";
"Cancel" = "取消";

/* About */
"Keeps audio outputs awake by always playing an inaudible stream." = "通过持续播放听不见的音频流，防止音频输出设备进入休眠。";
